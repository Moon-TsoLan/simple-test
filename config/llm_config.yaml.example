# LLM 配置模板：复制为 llm_config.yaml 后填写。
# 注意：api_key 不要写入本文件，请使用环境变量 LLM_API_KEY。

backend: api            # api | local
provider: dashscope     # dashscope | deepseek | openai_compatible

api:
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  model: "qwen-plus"
  api_key_env: "LLM_API_KEY"     # 从该环境变量读取 key
  timeout_seconds: 120
  max_retries: 3
  structured_outputs: false  # provider/model支持严格JSON Schema时改为true
  input_price_per_million_yuan: 0
  output_price_per_million_yuan: 0

rate_limit:
  max_rpm: 60          # 每分钟最多请求数
  max_tpm: 120000      # 每分钟最多 token 数
  concurrency: 3       # 并发数

budget:
  max_total_tokens: 2000000   # token 上限
  max_cost_yuan: 50.0         # 费用上限（仅提示，按 provider 单价估算）

silver:
  input: "dataset_build/crawl/html"
  output_dir: "dataset_build/silver"
  state_file: "run/state/silver_state.jsonl"
  usage_file: "run/logs/llm_usage.jsonl"
  batch_order: [3, 10, 30]    # 分批评测规模，最后一轮全量
  temperature: 0.0
  max_tokens: 1024
  few_shot_count: 3

local:
  server_url: "http://127.0.0.1:8080"
  model: "qwen2.5-1.5b-instruct"
  gguf_model: "models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf"
  structured_outputs: false
  ngl: 99
  context_size: 4096
